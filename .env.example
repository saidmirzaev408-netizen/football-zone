# Football Zone Configuration
# Set VITE_DATA_MODE to 'demo' to use rich built-in realistic football data, or 'api' to connect to live football API
VITE_DATA_MODE=demo

# Optional: Football-Data.org API Key (or API-Football RapidAPI key)
# When using real API mode with backend proxy:
VITE_FOOTBALL_API_URL=https://api.football-data.org/v4
VITE_FOOTBALL_API_KEY=your_football_api_key_here

# Backend Proxy URL (recommended for production to hide secrets)
VITE_BACKEND_PROXY_URL=http://localhost:5000/api
